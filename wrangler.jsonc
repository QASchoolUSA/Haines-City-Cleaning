{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "haines-city-cleaning",
	"compatibility_date": "2026-07-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "haines-city-cleaning"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"kv_namespaces": [
		{
			// CF namespace title: BOOKING_OUTBOX_HAINES_CITY
			"binding": "BOOKING_OUTBOX",
			"id": "d222dea6af504b3c8dffadddde4b32a9"
		}
	],
	"vars": {
		"BOOKING_BROOM_URL": "https://bookings.kedrik.com",
		"BOOKING_BROOM_SITE_SLUG": "haines-city",
		"NEXT_PUBLIC_SITE_URL": "https://hainescitycleaning.com"
	}
}
